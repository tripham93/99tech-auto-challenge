{
  "name": "demoblaze-qa-challenge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api --config=playwright.config.ts --project=api",
    "test:bdd": "cucumber-js",
    "test:all": "npm test && npm run test:bdd",
    "test:headed": "playwright test --headed",
    "test:performance": "k6 run performance/login-smoke.js",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@cucumber/cucumber": "^12.5.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "~3.11.1",
    "allure-playwright": "~3.11.1",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}